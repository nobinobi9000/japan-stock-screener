# Supabase（kabu-note/kabu-signalと共通のプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe webhookから account_entitlements / account_external_identities へ
# RLSを越えて書き込むための管理者キー。絶対にNEXT_PUBLIC_を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe（テストモードのキーのみ使用。本番キーへの切替は財務局への事前照会完了後）
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_BASIC_PRICE_ID=price_xxxx
NEXT_PUBLIC_BILLING_ENABLED=false  # 課金導線の表示。財務局への事前照会完了までfalseのまま
